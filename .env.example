# Copy to .env and fill in per-project values.
# Frontend env vars must be prefixed with VITE_ to reach the client.

# VITE_API_URL=
# VITE_ANALYTICS_KEY=

# Secrets used only on the Rust side should NOT be prefixed with VITE_.
# They can be read via std::env::var in src-tauri/src/.

# Public Polar values embedded into signed desktop builds. GitHub supplies
# these from repository variables. Export them in the build shell for a local
# release build because Cargo does not load this file automatically.
HUM_POLAR_ORGANIZATION_ID=
HUM_POLAR_CHECKOUT_URL=
HUM_POLAR_CUSTOMER_PORTAL_URL=
